# Copy to .env and fill in real values. Never commit .env.

# Leave empty — the app calls the API on the same origin it's served from (production:
# see root server.js; local dev: the Vite proxy in vite.config.ts forwards /api and
# /uploads to the API on port 4000). Only set this for a split deployment where the API
# lives on a different domain than this frontend.
VITE_API_URL=

# OAuth client ID from https://console.cloud.google.com/apis/credentials (type: "Web
# application"). Leave empty to hide the "Continuar com Google" button entirely — the
# backend's GOOGLE_CLIENT_ID must be set to the SAME value for it to work end to end.
VITE_GOOGLE_CLIENT_ID=
