# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=4000

# Postgres connection string
DATABASE_URL="postgresql://ateliedanay:ateliedanay@localhost:5432/ateliedanay?schema=public"

# Frontend origin allowed by CORS (comma-separated if more than one, e.g. staging)
CORS_ORIGIN="http://localhost:5173"

# Cookie domain for auth cookies (leave blank for localhost)
COOKIE_DOMAIN=

# JWT access token signing secret — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET="CHANGE_ME_64_BYTES_HEX"
ACCESS_TOKEN_TTL_MINUTES=15

# Refresh token lifetime (used when "mantenha-me conectado" is checked vs not)
REFRESH_TOKEN_TTL_DAYS_REMEMBERED=30
REFRESH_TOKEN_TTL_DAYS_SESSION=1

# CSRF secret — generate the same way as JWT_ACCESS_SECRET
CSRF_SECRET="CHANGE_ME_64_BYTES_HEX"

# Account lockout policy
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Optional — used only by `npm run prisma:seed` to create the first admin account.
# If unset, the seed script skips admin creation and logs a warning.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# OAuth client ID from https://console.cloud.google.com/apis/credentials, same value as
# the frontend's VITE_GOOGLE_CLIENT_ID. Leave empty to disable "Entrar com Google"
# (the endpoint responds 503 instead of crashing).
GOOGLE_CLIENT_ID=
